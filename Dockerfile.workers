FROM python:3.12.11-alpine3.22

ARG G2P_REF=2.0

RUN apk add --no-cache --virtual .build-deps gcc libc-dev linux-headers make \
 && apk add --no-cache bash git gettext libpq-dev libffi-dev openssl-dev

WORKDIR /app

# Core libs
RUN python3 -m pip install --no-cache-dir git+https://github.com/openg2p/openg2p-fastapi-common@1.1#subdirectory=openg2p-fastapi-common \
 && python3 -m pip install --no-cache-dir git+https://github.com/openg2p/openg2p-g2pconnect-common-lib@1.1#subdirectory=openg2p-g2pconnect-common-lib \
 && python3 -m pip install --no-cache-dir git+https://github.com/openg2p/openg2p-g2pconnect-common-lib@1.1#subdirectory=openg2p-g2pconnect-mapper-lib

# Always from openg2p-g2p-bridge repo (no local installs)
# Update pip and setuptools first
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools

# Install models first (known to work)
RUN python3 -m pip install --no-cache-dir \
    "git+https://github.com/PSNAppz/openg2p-g2p-bridge@${G2P_REF}#subdirectory=openg2p-g2p-bridge-models"

# Install celery workers separately for better error isolation
RUN python3 -m pip install --no-cache-dir \
    "git+https://github.com/PSNAppz/openg2p-g2p-bridge@${G2P_REF}#subdirectory=openg2p-g2p-bridge-celery-workers"

# Dynamic adapters from workflow (optional; e.g., bank/geo/notification connectors)
COPY adapters.requirements.txt /tmp/adapters.requirements.txt
RUN if [ -s /tmp/adapters.requirements.txt ]; then pip install --no-cache-dir -r /tmp/adapters.requirements.txt; fi

RUN apk del --no-network .build-deps

ENV PYTHONUNBUFFERED=1

# Use module path for Celery app (no local main.py)
CMD ["celery", "-A", "openg2p_g2p_bridge_celery_workers.main.celery_app", "worker", "-Q", "g2p_bridge_celery_worker_tasks", "--loglevel=debug"]
