FROM python:3.12.11-alpine3.22

ARG G2P_REF=2.0

RUN apk add --no-cache --virtual .build-deps gcc libc-dev linux-headers make \
 && apk add --no-cache bash git gettext libpq-dev libffi-dev openssl-dev

WORKDIR /app

# Core libs
RUN pip install --no-cache-dir git+https://github.com/openg2p/openg2p-fastapi-common@1.1#subdirectory=openg2p-fastapi-common \
 && pip install --no-cache-dir git+https://github.com/openg2p/openg2p-g2pconnect-common-lib@1.1#subdirectory=openg2p-g2pconnect-common-lib

# Always from openg2p-g2p-bridge repo (no local installs)
# Update pip and setuptools first
RUN pip install --no-cache-dir --upgrade pip setuptools

# Install models first (known to work)
RUN pip install --no-cache-dir \
    "git+https://github.com/PSNAppz/openg2p-g2p-bridge@${G2P_REF}#subdirectory=openg2p-g2p-bridge-models"

# Install celery beat producers separately for better error isolation
RUN pip install --no-cache-dir \
    "git+https://github.com/PSNAppz/openg2p-g2p-bridge@${G2P_REF}#subdirectory=openg2p-g2p-bridge-celery-beat-producers"

# Dynamic adapters for beat (optional)
COPY adapters.requirements.txt /tmp/adapters.requirements.txt
RUN if [ -s /tmp/adapters.requirements.txt ]; then pip install --no-cache-dir -r /tmp/adapters.requirements.txt; fi

RUN apk del --no-network .build-deps

ENV PYTHONUNBUFFERED=1

# Use module path for Celery beat app
CMD ["celery", "-A", "openg2p_g2p_bridge_celery_beat_producers.main.celery_app", "worker", "--beat", "--loglevel=info", "--schedule=/tmp/celery-beat-schedule.db"]
