FROM python:3.12.11-slim

ARG G2P_REF=2.0

# Install build and runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libc6-dev \
    libpq-dev \
    libffi-dev \
    libssl-dev \
    git \
    # Runtime dependencies
    libpq5 \
    libffi8 \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Set build optimizations
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_COMPILE=1

WORKDIR /app

# Pre-install psycopg2-binary and force it to be used instead of psycopg2
RUN pip install --upgrade pip setuptools wheel && \
    pip install psycopg2-binary

# Create constraints file to force psycopg2-binary usage
RUN echo "psycopg2-binary" > /tmp/constraints.txt && \
    echo "psycopg2==999999; sys_platform == \"impossible\"" >> /tmp/constraints.txt

# Set constraint to prevent psycopg2 compilation
ENV PIP_CONSTRAINT=/tmp/constraints.txt

# Dynamic adapters from workflow (optional; e.g., bank/geo/notification connectors)
COPY adapters.requirements.txt /tmp/adapters.requirements.txt
RUN if [ -s /tmp/adapters.requirements.txt ]; then pip install --constraint /tmp/constraints.txt -r /tmp/adapters.requirements.txt; fi

# Install all Python packages with constraints to force psycopg2-binary
RUN pip install --constraint /tmp/constraints.txt \
        git+https://github.com/openg2p/openg2p-fastapi-common@1.1#subdirectory=openg2p-fastapi-common \
        git+https://github.com/openg2p/openg2p-g2pconnect-common-lib@1.1#subdirectory=openg2p-g2pconnect-common-lib \
        git+https://github.com/openg2p/openg2p-g2pconnect-common-lib@1.1#subdirectory=openg2p-g2pconnect-mapper-lib \
        "git+https://github.com/psnappz/openg2p-g2p-bridge@${G2P_REF}#subdirectory=openg2p-g2p-bridge-models" \
        "git+https://github.com/psnappz/openg2p-g2p-bridge@${G2P_REF}#subdirectory=openg2p-g2p-bridge-celery-workers"

# Clean up build dependencies to reduce image size
RUN apt-get remove -y gcc g++ libc6-dev libpq-dev libffi-dev libssl-dev git \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1

# Use module path for Celery app (no local main.py)
CMD ["celery", "-A", "openg2p_g2p_bridge_celery_workers.main.celery_app", "worker", "-Q", "g2p_bridge_celery_worker_tasks", "--loglevel=debug"]