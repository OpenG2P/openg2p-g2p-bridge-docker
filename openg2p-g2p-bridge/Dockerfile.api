# Multi-stage build for better caching and smaller final image
FROM python:3.12.11-alpine3.22 AS base

# Install system dependencies in a separate layer
RUN apk add --no-cache --virtual .build-deps gcc libc-dev linux-headers make \
 && apk add --no-cache bash git gettext libpq-dev libmagic

WORKDIR /app

# Upgrade pip and install build tools first (cached layer)
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

FROM base AS adapters

# Configure git for faster clones and parallel processing
RUN git config --global advice.detachedHead false && \
    git config --global init.defaultBranch main

# Copy and install adapter dependencies FIRST (they contain core deps)
COPY adapters.requirements.txt /tmp/adapters.requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/tmp/.git-cache \
    if [ -s /tmp/adapters.requirements.txt ]; then \
        PIP_PARALLEL_BUILDS=${PIP_PARALLEL_BUILDS:-4} pip install \
        --disable-pip-version-check \
        --no-warn-script-location \
        --prefer-binary \
        -r /tmp/adapters.requirements.txt; \
    fi

FROM adapters AS dependencies

ARG G2P_REF=2.0

# Create requirements file for better caching
RUN echo "git+https://github.com/psnappz/openg2p-fastapi-common@1.1#subdirectory=openg2p-fastapi-common" > /tmp/core_requirements.txt && \
    echo "git+https://github.com/psnappz/openg2p-g2pconnect-common-lib@1.1#subdirectory=openg2p-g2pconnect-common-lib" >> /tmp/core_requirements.txt && \
    echo "git+https://github.com/psnappz/openg2p-g2p-bridge@${G2P_REF}#subdirectory=openg2p-g2p-bridge-models" >> /tmp/core_requirements.txt && \
    echo "git+https://github.com/psnappz/openg2p-g2p-bridge@${G2P_REF}#subdirectory=openg2p-g2p-bridge-api" >> /tmp/core_requirements.txt

# Install core dependencies with optimizations
RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/tmp/.git-cache \
    PIP_PARALLEL_BUILDS=${PIP_PARALLEL_BUILDS:-4} pip install \
    --disable-pip-version-check \
    --no-warn-script-location \
    --prefer-binary \
    -r /tmp/core_requirements.txt

FROM dependencies AS final

# Clean up build dependencies
RUN apk del --no-network .build-deps

ENV PYTHONUNBUFFERED=1
ENV G2P_BRIDGE_NO_OF_WORKERS=2
ENV G2P_BRIDGE_HOST=0.0.0.0
ENV G2P_BRIDGE_PORT=8000
ENV G2P_BRIDGE_WORKER_TYPE=gunicorn

# Use module path for migrate and Gunicorn WSGI app
CMD python3 -m openg2p_g2p_bridge_api.main migrate; \
    gunicorn "openg2p_g2p_bridge_api.main:app" --workers ${G2P_BRIDGE_NO_OF_WORKERS} --worker-class uvicorn.workers.UvicornWorker --bind ${G2P_BRIDGE_HOST}:${G2P_BRIDGE_PORT}
