FROM python:3.12.11-slim

ARG G2P_REF=v2.0.0

# Install build and runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libc6-dev \
    libpq-dev \
    libmagic-dev \
    git \
    # Runtime dependencies
    gettext \
    libpq5 \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

# Set build optimizations
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_COMPILE=1

WORKDIR /app

# Install pip and tools
RUN pip install --upgrade pip setuptools wheel

# Core libs
RUN pip install git+https://github.com/openg2p/openg2p-fastapi-common@v1.1.3#subdirectory=openg2p-fastapi-common \
    git+https://github.com/openg2p/openg2p-g2pconnect-common-lib@v2.0.0#subdirectory=openg2p-g2pconnect-common-lib

# Install bridge components
RUN pip install \
    "git+https://github.com/openg2p/openg2p-g2p-bridge@${G2P_REF}#subdirectory=openg2p-g2p-bridge-models" \
    "git+https://github.com/openg2p/openg2p-g2p-bridge@${G2P_REF}#subdirectory=openg2p-g2p-bridge-api"

# Dynamic deps from workflow (optional)
COPY adapters.requirements.txt /tmp/adapters.requirements.txt
RUN if [ -s /tmp/adapters.requirements.txt ]; then pip install -r /tmp/adapters.requirements.txt; fi

# Clean up build dependencies to reduce image size
RUN apt-get remove -y gcc g++ libc6-dev libpq-dev libmagic-dev git \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1
ENV G2P_BRIDGE_NO_OF_WORKERS=2
ENV G2P_BRIDGE_HOST=0.0.0.0
ENV G2P_BRIDGE_PORT=8000
ENV G2P_BRIDGE_WORKER_TYPE=gunicorn

# Use module path for migrate and Gunicorn WSGI app
CMD python3 -m openg2p_g2p_bridge_api.main migrate; \
    gunicorn "openg2p_g2p_bridge_api.main:app" --workers ${G2P_BRIDGE_NO_OF_WORKERS} --worker-class uvicorn.workers.UvicornWorker --bind ${G2P_BRIDGE_HOST}:${G2P_BRIDGE_PORT}